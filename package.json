{
  "name": "vanillin",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "bin": { "van": "bin/van.mjs" },
  "files": [
    "bin/van.mjs",
    "lib/",
    "registry.json",
    "scripts/build-registry.mjs",
    "scripts/build-theme.mjs",
    "scripts/config-schema.mjs",
    "scripts/manifest.mjs",
    "styles/",
    "ui/"
  ],
  "description": "Zero-dependency React components. Copy-paste JSX + CSS, that's it.",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:tokens && vite build",
    "check:tokens": "node scripts/check-tokens.mjs",
    "preview": "vite preview",
    "test": "node tests/run.mjs",
    "contracts": "node scripts/manifest.mjs --write && node scripts/build-registry.mjs --write",
    "theme": "node scripts/build-theme.mjs",
    "theme:defaults": "node scripts/build-theme.mjs --defaults",
    "schema": "node scripts/gen-schema.mjs"
  },
  "engines": { "node": ">=18.17" },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true },
    "react-dom": { "optional": true }
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.4.1",
    "axe-core": "^4.12.1",
    "playwright-core": "^1.61.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vite": "^6.3.5"
  }
}
